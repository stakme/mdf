{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"includes": [
			"docs/**",
			"scripts/**",
			"src/**",
			"tests/**",
			"TODO/**",
			"viewer-app/**",
			"README.md",
			"CHANGELOG.md"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		},
		"includes": [
			"docs/**",
			"scripts/**",
			"src/**",
			"tests/**",
			"TODO/**",
			"viewer-app/**/*.{ts,tsx}",
			"README.md",
			"CHANGELOG.md"
		]
	},
	"javascript": {},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"recommended": true
			}
		}
	}
}
