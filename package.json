{
	"name": "@stakme/mdf",
	"version": "0.7.0",
	"description": "Lightweight utility to organize Markdown files with front matter",
	"author": "@stakme",
	"repository": {
		"type": "git",
		"url": "https://github.com/stakme/mdf.git"
	},
	"type": "module",
	"bin": {
		"mdf": "./dist/cli.mjs"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./config": {
			"types": "./dist/index.d.mts",
			"import": "./dist/config.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"scripts": {
		"build": "tsdown --config tsdown.config.ts",
		"postbuild": "node ./scripts/ensure-cli-shebang.mjs",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.types.json",
		"prepare": "npm run build",
		"prepublishOnly": "npm run build",
		"test": "npm run build && vitest run",
		"test:watch": "vitest",
		"publish:local": "node ./scripts/publish.mjs"
	},
	"keywords": [
		"markdown",
		"front matter",
		"notes"
	],
	"dependencies": {
		"@hono/node-server": "^1.13.5",
		"commander": "^14.0.1",
		"hono": "^4.6.12",
		"marked": "^15.0.11",
		"typescript": "^5.9.2",
		"yaml": "^2.8.1",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/node": "^24.5.2",
		"execa": "^9.5.2",
		"tsdown": "^0.5.10",
		"vitest": "^2.1.3"
	},
	"engines": {
		"node": ">=22"
	}
}
