{
	"name": "@stakme/mdf",
	"version": "0.7.0",
	"description": "Lightweight utility to organize Markdown files with front matter",
	"author": "@stakme",
	"repository": {
		"type": "git",
		"url": "https://github.com/stakme/mdf.git"
	},
	"type": "module",
	"bin": {
		"mdf": "./dist/cli.mjs"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./config": {
			"types": "./dist/index.d.mts",
			"import": "./dist/config.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"scripts": {
		"build": "tsdown --config tsdown.config.ts && npm run viewer:build",
		"postbuild": "node ./scripts/ensure-cli-shebang.mjs",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.types.json",
		"prepare": "npm run build",
		"prepublishOnly": "npm run build",
		"test": "npm run build && vitest run",
		"test:watch": "vitest",
		"publish:local": "node ./scripts/publish.mjs",
		"viewer:build": "vite build --config viewer-app/vite.config.ts",
		"viewer:dev": "vite --config viewer-app/vite.config.ts"
	},
	"keywords": [
		"markdown",
		"front matter",
		"notes"
	],
	"dependencies": {
		"@hono/node-server": "^1.13.5",
		"commander": "^14.0.1",
		"hono": "^4.6.12",
		"marked": "^15.0.11",
		"typescript": "^5.9.2",
		"yaml": "^2.8.1",
		"zod": "^4.1.11",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/node": "^24.5.2",
		"execa": "^9.5.2",
		"tsdown": "^0.5.10",
		"vitest": "^2.1.3",
		"@types/react": "^18.3.5",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react-swc": "^3.7.0",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.13",
		"vite": "^5.4.3"
	},
	"engines": {
		"node": ">=22"
	}
}
