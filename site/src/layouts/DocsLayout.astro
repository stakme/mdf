---
// biome-ignore lint/correctness/noUnusedImports: Component is referenced within the Astro template markup
import PageShell from "../components/PageShell.astro";
import type { ViewerEntryMeta } from "../lib/viewerMeta";

type DocsLayoutProps = {
	title?: string;
	description?: string;
	metadata?: ViewerEntryMeta;
};

// biome-ignore lint/correctness/noUnusedVariables: Props are consumed in the Astro template markup
const props = Astro.props as DocsLayoutProps;
---
<PageShell title={props.title}>
  <div class="flex flex-col gap-4">
    {props.title && (
      <h1 class="text-3xl font-semibold tracking-tight">{props.title}</h1>
    )}
    {props.description && (
      <p class="max-w-3xl text-base text-neutral-600 dark:text-neutral-400">
        {props.description}
      </p>
    )}
    {props.metadata && (
      <div class="flex flex-wrap gap-2 text-sm text-neutral-500 dark:text-neutral-400">
        {props.metadata.virtualPath && (
          <span class="rounded bg-neutral-100 px-2 py-1 dark:bg-neutral-900">
            Path: {props.metadata.virtualPath}
          </span>
        )}
        {props.metadata.author && (
          <span class="rounded bg-neutral-100 px-2 py-1 dark:bg-neutral-900">
            Author: {props.metadata.author}
          </span>
        )}
        {props.metadata.createdAt && (
          <span class="rounded bg-neutral-100 px-2 py-1 dark:bg-neutral-900">
            Created: {props.metadata.createdAt}
          </span>
        )}
        {props.metadata.updatedAt && (
          <span class="rounded bg-neutral-100 px-2 py-1 dark:bg-neutral-900">
            Updated: {props.metadata.updatedAt}
          </span>
        )}
        {props.metadata.tags.map((tag) => (
          <span class="rounded bg-neutral-100 px-2 py-1 dark:bg-neutral-900">{tag}</span>
        ))}
      </div>
    )}
  </div>
  <div class="mt-6">
    <slot />
  </div>
</PageShell>
