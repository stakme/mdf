---
import "../styles/global.css";
// biome-ignore lint/correctness/noUnusedImports: Component is referenced within the Astro template markup
import ThemeToggle from "./ThemeToggle.tsx";

type PageShellProps = { title?: string };
// biome-ignore lint/correctness/noUnusedVariables: Props are consumed in the Astro template markup
const props = Astro.props as PageShellProps;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {props.title && <title>{props.title}</title>}
  </head>
  <body class="min-h-screen bg-white text-neutral-900 transition-colors dark:bg-neutral-950 dark:text-neutral-100">
    <header class="flex items-center justify-between gap-4 border-b border-neutral-200 px-4 py-4 dark:border-neutral-800 md:px-6">
      <a href="/" class="font-semibold tracking-tight">mdf</a>
      <ThemeToggle client:only="react" />
    </header>
    <main class="mx-auto w-full max-w-5xl px-4 py-8 md:px-6">
      <slot />
    </main>
  </body>
</html>
